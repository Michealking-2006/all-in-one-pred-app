{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/mingt-t",
      "destination": "/mingt-t/index.html"
    },
    {
      "source": "/api/config",
      "destination": "/api/public?route=config"
    },
    {
      "source": "/api/accuracy",
      "destination": "/api/public?route=accuracy"
    },
    {
      "source": "/api/predictions",
      "destination": "/api/public?route=predictions"
    },
    {
      "source": "/api/usage",
      "destination": "/api/public?route=usage"
    },
    {
      "source": "/api/placement-event",
      "destination": "/api/public?route=placement-event"
    },
    {
      "source": "/api/csp-report",
      "destination": "/api/public?route=csp-report"
    },
    {
      "source": "/api/feedback",
      "destination": "/api/public?route=feedback"
    },
    {
      "source": "/api/push",
      "destination": "/api/public?route=push"
    },
    {
      "source": "/api/news",
      "destination": "/api/public?route=news"
    },
    {
      "source": "/api/me",
      "destination": "/api/account?route=me"
    },
    {
      "source": "/api/spend",
      "destination": "/api/account?route=spend"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/account?route=checkout"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?doc=sitemap"
    },
    {
      "source": "/sitemap-:part(pages|leagues|clubs|matches|news).xml",
      "destination": "/api/seo?doc=sitemap&part=:part"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/seo?doc=feed"
    },
    {
      "source": "/llms.txt",
      "destination": "/api/seo?doc=llms"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/seo?doc=robots"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|google-pagerenderer|storebot|adsbot-google|bingbot|bingpreview|duckduckbot|duckassistbot|slurp|baiduspider|yandex|applebot|facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|discordbot|pinterestbot|redditbot|mastodon|skypeuripreview|viber|embedly|iframely|vkshare|flipboard|tumblr|petalbot|semrushbot|ahrefsbot|gptbot|chatgpt-user|oai-searchbot|perplexitybot|claudebot|ccbot|amazonbot|bytespider).*"
        }
      ],
      "destination": "/api/seo?path=/"
    },
    {
      "source": "/:path((?!api/|src/|icons/|mingt-t)[^.]*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(googlebot|google-inspectiontool|google-pagerenderer|storebot|adsbot-google|bingbot|bingpreview|duckduckbot|duckassistbot|slurp|baiduspider|yandex|applebot|facebookexternalhit|facebot|twitterbot|linkedinbot|whatsapp|telegrambot|slackbot|discordbot|pinterestbot|redditbot|mastodon|skypeuripreview|viber|embedly|iframely|vkshare|flipboard|tumblr|petalbot|semrushbot|ahrefsbot|gptbot|chatgpt-user|oai-searchbot|perplexitybot|claudebot|ccbot|amazonbot|bytespider).*"
        }
      ],
      "destination": "/api/seo?path=/:path"
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/((?!mingt-t).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https://*.supabase.co https://formspree.io; worker-src 'self'; manifest-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self' https://formspree.io; frame-ancestors 'none'; upgrade-insecure-requests; report-uri /api/csp-report"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/mingt-t(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?task=grade",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron?task=predict",
      "schedule": "0 6 * * *"
    }
  ],
  "functions": {
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/mingt.js": {
      "maxDuration": 60
    }
  },
  "trailingSlash": false
}
