# Copy to .env for `vercel dev`, and add the same variable in
# Vercel -> Project Settings -> Environment Variables. Never commit the real key.
SCOUTWAVE_FOOTBALL_API_KEY=your_api_football_key_here
# TheNewsAPI token (https://www.thenewsapi.com) used by api/news.js
NEWS_ACCESS=your_thenewsapi_token_here
# Optional: your public domain, used for canonical URLs and the sitemap
SITE_URL=https://your-domain.com
# --- Admin dashboard (/mingt-t): see docs/ADMIN.md; generate values with `node scripts/admin-setup.mjs "passphrase"`
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_TOTP_SECRET=
ADMIN_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
