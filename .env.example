# Copy to .env for `vercel dev`, and add the same variable in
# Vercel -> Project Settings -> Environment Variables. Never commit the real key.
SCOUTWAVE_FOOTBALL_API_KEY=your_api_football_key_here
# TheNewsAPI token (https://www.thenewsapi.com) used by api/news.js
NEWS_ACCESS=your_thenewsapi_token_here
# Optional: your public domain, used for canonical URLs and the sitemap
SITE_URL=https://your-domain.com
# --- Admin dashboard (/mingt-t): see docs/ADMIN.md; generate values with `node scripts/admin-setup.mjs "passphrase"`
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_TOTP_SECRET=
ADMIN_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# --- Payments (Polar, polar.sh): see docs/PAYMENTS.md
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Use "sandbox" while testing with Polar's sandbox (sandbox.polar.sh); leave empty for live payments.
POLAR_SERVER=
# One Polar product id per item (one-time products, not subscriptions).
POLAR_PRODUCT_PREMIUM_1M=
POLAR_PRODUCT_PREMIUM_12M=
POLAR_PRODUCT_COINS_10=
POLAR_PRODUCT_COINS_50=
POLAR_PRODUCT_COINS_120=
POLAR_PRODUCT_COINS_300=
# --- Server-side predictions: see docs/PREDICTIONS.md
# Required: Vercel sends this as "Authorization: Bearer ..." when it runs the scheduled jobs. Any long random string (16+ characters).
CRON_SECRET=
# Optional: how many football API requests a job may use (default 40) and the share of today's remaining quota (default 0.35)
PREDICT_MAX_CALLS=
PREDICT_QUOTA_SHARE=
# Optional: only these league ids, comma-separated (empty = every competition that has a league table)
PREDICT_LEAGUES=
# Optional: 1 = also fetch bookmaker odds to compare against (costs extra football API requests)
PREDICT_ODDS=
PREDICT_ODDS_BOOKMAKER=
# Optional: OpenAI writes a short plain-language note for the N most confident matches each run. It never changes a probability.
OPENAI_API_KEY=
OPENAI_MODEL=
PREDICT_EXPLAIN_MAX=
# Optional: matches that must be graded before the app shows an accuracy figure (default 200)
PREDICT_MIN_PUBLISH=
# --- Push notifications: see docs/NOTIFICATIONS.md. Generate the keys with:  node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Optional: share of today's football API quota the alert job must leave free for the app (default 0.25)
PUSH_KEEP_FREE_SHARE=
# --- Admin sign-in (see docs/ADMIN.md). ADMIN_TOTP_SECRET is required: without it nobody can sign in.
# Optional: minutes of inactivity before an admin session ends (default 30, allowed 5 to 240)
ADMIN_IDLE_MINUTES=
# Optional: 1 = also end a session if the network (IP range) changes. Safer, but signs you out when a phone changes network.
ADMIN_BIND_IP=
